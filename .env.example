# Public Supabase project configuration. DO NOT put a service-role/secret key in VITE_ variables.
# Leave unset to see the onboarding preview without sending personal information.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable explicitly only while testing. Demo creates NO real account and bypasses no backend checks.
VITE_ENABLE_DEMO_MODE=true
